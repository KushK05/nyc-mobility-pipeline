# GCP project that hosts the BigQuery datasets
GCP_PROJECT_ID=your-gcp-project-id
# Path to the service-account key JSON (never commit this file)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-key.json
# BigQuery dataset location
BQ_LOCATION=US
# Anthropic API key for the chatbot
ANTHROPIC_API_KEY=
# Model used by the chatbot
LLM_MODEL=claude-opus-5-5
